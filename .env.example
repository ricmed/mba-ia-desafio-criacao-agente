# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Usar a Gemini Developer API (AI Studio), nao a Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo Gemini usado pelos agentes
AURORA_MODELO=gemini-3.6-flash

# Diretorio onde ficam os bancos SQLite (dados do condominio e sessoes)
AURORA_DB_DIR=var
